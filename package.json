    "@solana/spl-token": "^0.3.9"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.11",
    "@types/chai": "^4.3.11",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.2",
    "ts-jest": "^29.1.1",
    "jest": "^29.7.0",
    "chai": "^4.3.10",
    "eslint": "^8.55.0",
    "@typescript-eslint/parser": "^6.13.2",
    "@typescript-eslint/eslint-plugin": "^6.13.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
